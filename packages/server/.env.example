# --- Ascolto ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Ingest ---
# Token accettati sull'endpoint di raccolta, separati da virgola.
# Generarli con: openssl rand -hex 32
# Elencarne piu' d'uno permette di ruotarli senza interrompere i client.
INGEST_TOKENS=

# --- TLS ---
# Necessario se il servizio non sta dietro un terminatore TLS.
TLS_KEY_PATH=
TLS_CERT_PATH=

# --- Storage ---
DATABASE_URL=postgres://copilot:copilot@localhost:5433/copilot_usage
DB_SSL=false
# Flush del writer batch
FLUSH_INTERVAL_MS=2000
FLUSH_MAX_BATCH=100
