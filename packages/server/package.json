{
  "name": "@vidiemme/copilot-usage-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servizio di raccolta: prezza gli eventi, li conserva ed espone il reporting",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -b && npm run copy-assets",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "npm run build && node dist/storage/migrate.js",
    "verify-reporting": "npm run build && node scripts/verify-reporting.mjs",
    "copy-assets": "node -e \"require('node:fs').cpSync('src/storage/migrations','dist/storage/migrations',{recursive:true})\""
  },
  "dependencies": {
    "@vidiemme/copilot-usage-contract": "0.1.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
