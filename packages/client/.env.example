# Serve solo a chi sviluppa il proxy da questo repository. Sulle postazioni non
# esiste nessun .env: `setup` scrive ~/.config/copilot-proxy/config.json, e
# endpoint di raccolta, salt e cartelle di lavoro sono default committati in
# src/defaults.ts.
#
# Copia in .env e valorizza il token: e' l'unica chiave senza default.

# --- Obbligatoria ---

# Token di ingest, lo stesso per tutta l'organizzazione. Chiedilo a chi
# amministra il collector.
COLLECTOR_TOKEN=

# --- Opzionali: i valori mostrati sono i default ---

# Endpoint del servizio di raccolta. In http semplice e' ammesso solo verso
# localhost: altrove il token di ingest viaggerebbe in chiaro. In sviluppo si
# punta al collector locale: http://127.0.0.1:8080/v1/usage
#COLLECTOR_URL=https://copilot-collector.swarm.vidiemme.it/v1/usage

# Salt per lo pseudonimo del developer. DEVE essere identico su tutte le
# macchine, altrimenti la stessa persona compare con id diversi.
#DEVELOPER_ID_SALT=<la costante in src/defaults.ts>

# Cartelle sotto cui vivono i repository: il proxy risale dai path citati nelle
# richieste fino al marker di progetto piu' vicino. Default: la home.
#WORKSPACE_ROOTS=/Users/nome.cognome/Work

# Ascolto locale. Il proxy gira sulla macchina del developer, quindi si
# affaccia solo su localhost.
#PORT=8787
#HOST=127.0.0.1
#LOG_LEVEL=info

# Dove inoltrare le richieste: l'endpoint Copilot diretto, oppure un traduttore
# Anthropic<->Copilot in ascolto in locale (es. http://127.0.0.1:4141).
#UPSTREAM_BASE_URL=https://api.githubcopilot.com
# Se valorizzato, sovrascrive l'header Authorization in uscita. Vuoto = passthrough
# del token inviato dal client, che e' quel che serve quasi sempre.
#UPSTREAM_AUTH_TOKEN=

#COLLECTOR_TIMEOUT_MS=10000
#FLUSH_INTERVAL_MS=5000
#FLUSH_MAX_BATCH=100
# Dove parcheggiare gli eventi quando il collector non risponde.
# Vuoto = <cartella di configurazione>/spool.jsonl
#SPOOL_PATH=

# TLS: serve solo se il proxy viene esposto oltre localhost.
#TLS_KEY_PATH=
#TLS_CERT_PATH=

# Cosa marca la radice di un progetto.
#PROJECT_MARKERS=.git,.hg,.svn
# Per quanto una sessione conserva l'ultimo progetto riconosciuto (30 minuti).
#PROJECT_STICKY_TTL_MS=1800000
# Nome dell'header che trasporta l'id progetto.
#PROJECT_HEADER=x-project-id
# Valore usato quando il progetto non e' determinabile.
#UNASSIGNED_PROJECT=unassigned
# Mappa opzionale token->progetto/developer, formato JSON:
# {"tok_abc":{"projectId":"acme-portal","developerId":"g.carassale"}}
#ATTRIBUTION_TOKENS={}
