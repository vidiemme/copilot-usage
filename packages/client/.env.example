# --- Ascolto locale ---
# Il proxy gira sulla macchina del developer: si affaccia solo su localhost.
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# --- Upstream ---
# Dove inoltrare le richieste. Puo' essere:
#  - l'endpoint Copilot diretto:            https://api.githubcopilot.com
#  - un traduttore Anthropic<->Copilot:     http://127.0.0.1:4141
UPSTREAM_BASE_URL=https://api.githubcopilot.com

# Se valorizzato, sovrascrive l'header Authorization in uscita.
# Lasciare vuoto per fare passthrough del token inviato dal client (consigliato).
UPSTREAM_AUTH_TOKEN=

# --- Collector ---
# Endpoint del servizio di raccolta. In http semplice e' ammesso solo verso
# localhost: altrove il token viaggerebbe in chiaro.
COLLECTOR_URL=https://copilot-usage.interno/v1/usage
# Token di ingest, lo stesso per tutta l'organizzazione.
COLLECTOR_TOKEN=
COLLECTOR_TIMEOUT_MS=10000
# Dove parcheggiare gli eventi quando il collector non risponde.
# Vuoto = <cartella di configurazione>/spool.jsonl
SPOOL_PATH=
FLUSH_INTERVAL_MS=5000
FLUSH_MAX_BATCH=100

# --- TLS ---
# Serve solo se il proxy viene esposto oltre localhost.
TLS_KEY_PATH=
TLS_CERT_PATH=

# --- Attribuzione ---
# Cartelle sotto cui vivono i repository: il proxy risale dai path citati nelle
# richieste fino al marker di progetto piu' vicino. E' cio' che permette di
# lavorare su n progetti in parallelo con una sola configurazione lato editor.
WORKSPACE_ROOTS=/Users/nome.cognome/Work
# Cosa marca la radice di un progetto.
PROJECT_MARKERS=.git,.hg,.svn
# Per quanto una sessione conserva l'ultimo progetto riconosciuto (30 minuti).
PROJECT_STICKY_TTL_MS=1800000
# Nome dell'header che trasporta l'id progetto.
PROJECT_HEADER=x-project-id
# Valore usato quando il progetto non e' determinabile.
UNASSIGNED_PROJECT=unassigned
# Mappa opzionale token->progetto/developer, formato JSON:
# {"tok_abc":{"projectId":"acme-portal","developerId":"g.carassale"}}
ATTRIBUTION_TOKENS={}
# Salt per lo pseudonimo del developer. DEVE essere identico su tutte le
# macchine, altrimenti la stessa persona compare con id diversi.
DEVELOPER_ID_SALT=change-me
